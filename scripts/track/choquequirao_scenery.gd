@tool
class_name ChoquequiraoScenery
extends TrackScenery
## Choquequirao (GDD 8.6f): an Inca village in a green Andean valley, Peru.
## The lap starts outside on the valley floor, enters through a gateway and
## spirals in through the village on a double spiral: inbound and outbound
## lanes alternate ring by ring, sunk between stone-walled grass terraces
## with the houses standing on them, so it reads as a labyrinth of rings.
## At the centre an S-bend crosses the plaza (great hall, usnu platform),
## then the road spirals back out between the inbound rings. Outside, the
## terraces step up the valley sides to cloud forest and jagged peaks. The
## shortcut runs past a row of qolqa storehouses on the hill spur. Fieldstone
## set in mortar everywhere (old but sturdy); a bright sunny day.
## Positions are layout coordinates matching choquequirao.tscn.

## Generated by gen_choq.py (scratchpad): layout points (track-local x, z).
const IN_GATE := Vector2(-143.74, 47.43)
const S_START := Vector2(25.96, 62.71)
const S_END := Vector2(-25.96, -62.71)
const OUT_GATE := Vector2(-15.82, 151.76)
## Centre of the S-bend's first arc: the great hall stands here, the usnu
## platform at the mirror point.
const PLAZA_EYE := Vector2(12.6, 31.51)

enum Section { LOBE, VILLAGE, PLAZA, QOLQA }

## Terrace profile: height steps STEP_H every STEP_DEPTH metres from
## LOBE_FIRST beyond the road edge, up to STEPS steps. In the village the
## first terrace starts right behind the barrier (VILLAGE_EDGE) one step up.
const STEP_H := 2.6
const STEP_DEPTH := 6.0
const LOBE_FIRST := 14.0
const STEPS := 6
const VILLAGE_EDGE := 1.8
const TERRACE_LIMIT := 60.0

const TERRAIN_BOUNDS := Rect2(-1000, -760, 1800, 1550)
const TERRAIN_CELL := 10.0
const VALLEY_CENTRE := Vector2(-100, 0)

## For tests: the gateways ([offset, Vector3(bottom half, top half, lintel
## height)]), buildings, terraces and storehouses.
var gates: Array = []
var buildings: IncaBuildingBuilder
var terrace_risers: int = 0
var qolqas: int = 0
var plaza_buildings: int = 0
var section_offsets: Dictionary = {}

var _noise: FastNoiseLite
var _peak_noise: FastNoiseLite
var _dist := PackedFloat32Array()
var _dnx: int = 0
var _dnz: int = 0
var _main_samples: Array = []
var _qolqa_samples: Array = []


func build() -> void:
	gates.clear()
	terrace_risers = 0
	qolqas = 0
	plaza_buildings = 0
	cast_shadows = true
	no_shadow_keys = ["terrace_top", "peak_green", "peak_rock", "snow", "hills"]
	_setup_materials()
	_find_sections()
	buildings = IncaBuildingBuilder.new(self, "stone", "lintel", "thatch", "rubble", "beam", random_seed + 3)
	await step(0.05)
	_terraces()
	await step(0.3)
	_gates()
	_village_houses()
	_plaza()
	_qolqa_row()
	await step(0.5)
	_distance_field()
	_noise = SceneryTerrain.make_noise(random_seed)
	_peak_noise = SceneryTerrain.make_noise(random_seed + 9)
	_peak_noise.frequency = 0.004
	SceneryTerrain.build(self, TERRAIN_BOUNDS, TERRAIN_CELL, 0.6, -100.0, "terrain_grass", "terrain_grass", "",
			random_seed, _carve)
	await step(0.75)
	_forest()
	_far_peaks()
	await step(0.9)


func _setup_materials() -> void:
	textured("stone", "old_stone_wall", Color(0.84, 0.76, 0.66), 2.6, 0.92)
	textured("terrace_wall", "old_stone_wall", Color(0.8, 0.73, 0.63), 3.2, 0.92)
	textured("lintel", "large_sandstone_blocks", Color(0.86, 0.8, 0.7), 2.2, 0.85)
	textured("rubble", "old_stone_wall", Color(0.78, 0.72, 0.64), 1.4, 0.95)
	textured("terrace_top", "sparse_grass", Color(0.62, 0.95, 0.42), 5.0, 0.95)
	textured("terrain_grass", "sparse_grass", Color(0.5, 0.82, 0.36), 9.0, 0.97)
	textured("thatch", "reed_roof_04", Color(0.95, 0.86, 0.66), 2.5, 0.95)
	material("beam", Color(0.33, 0.23, 0.15), 0.0, 0.0, 0.9)
	material("sign_wood", Color(0.36, 0.23, 0.13), 0.0, 0.0, 0.9)
	material("bark", Color(0.32, 0.26, 0.2), 0.0, 0.0, 0.9)
	material("canopy", Color(0.2, 0.42, 0.15), 0.0, 0.0, 0.85)
	material("peak_green", Color(0.22, 0.36, 0.18), 0.0, 0.0, 1.0)
	material("peak_rock", Color(0.45, 0.42, 0.38), 0.0, 0.0, 1.0)
	material("snow", Color(0.95, 0.96, 1.0), 0.0, 0.0, 0.7)


# --- layout ------------------------------------------------------------------------------

func _offset_of(p: Vector2) -> float:
	return track.curve.get_closest_offset(Vector3(p.x, 0, p.y))


func _find_sections() -> void:
	section_offsets = {"in": _offset_of(IN_GATE), "s_start": _offset_of(S_START), "plaza": _offset_of(Vector2.ZERO),
			"s_end": _offset_of(S_END), "out": _offset_of(OUT_GATE)}


func section_at(offset: float) -> int:
	var o := track.wrap_offset(offset)
	if o >= section_offsets.s_start and o < section_offsets.s_end:
		return Section.PLAZA
	if o >= section_offsets["in"] and o < section_offsets.out:
		return Section.VILLAGE
	return Section.LOBE


## Height of the terrace tread d metres beyond the road edge.
func terrace_height(section: int, d: float) -> float:
	match section:
		Section.PLAZA:
			return 0.0
		Section.VILLAGE:
			return 0.0 if d < VILLAGE_EDGE else STEP_H + _steps(d)
	return _steps(d)


func _steps(d: float) -> float:
	if d < LOBE_FIRST:
		return 0.0
	return STEP_H * mini(STEPS, int((d - LOBE_FIRST) / STEP_DEPTH) + 1)


func _breaks(section: int) -> PackedFloat32Array:
	var out := PackedFloat32Array()
	if section == Section.PLAZA:
		return out
	if section == Section.VILLAGE:
		out.append(VILLAGE_EDGE)
	for k in STEPS:
		out.append(LOBE_FIRST + k * STEP_DEPTH)
	return out


## Profile of whichever road is nearest a track-local point.
func _neighbour_section(p: Vector3) -> int:
	var main_pos := track.curve.get_closest_point(p)
	var best := Vector2(p.x - main_pos.x, p.z - main_pos.z).length()
	for sc in track.shortcuts:
		var q := sc.curve.get_closest_point(p)
		if Vector2(p.x - q.x, p.z - q.z).length() < best:
			return Section.QOLQA
	return section_at(track.curve.get_closest_offset(main_pos))


# --- terraces ----------------------------------------------------------------------------

func _terraces() -> void:
	var tb := TerraceBuilder.new(self, "terrace_wall", "terrace_top")
	tb.profile = terrace_height
	tb.breaks = _breaks
	tb.section_of = section_at
	tb.neighbour_section = _neighbour_section
	tb.limit = TERRACE_LIMIT
	_main_samples = tb.build_road(track.curve, track.road_width * 0.5, true)
	for sc in track.shortcuts:
		_qolqa_samples = tb.build_road(sc.curve, sc.road_width * 0.5, false, Section.QOLQA)
	terrace_risers = tb.riser_count


# --- gateways ------------------------------------------------------------------------------

## Main-loop offsets of the gateways: the village gates in and out, one on
## each outer ring, the plaza entrance and exit, and a pair on the S-bend.
func gate_offsets() -> PackedFloat32Array:
	var o := section_offsets
	return PackedFloat32Array([o["in"] + 14.0, lerpf(o["in"], o.s_start, 0.42), o.s_start - 18.0,
			o.plaza - 22.0, o.plaza + 22.0, o.s_end + 18.0, lerpf(o.s_end, o.out, 0.58), o.out - 14.0])


func _gates() -> void:
	for off in gate_offsets():
		var opening := IncaGateway.build(self, at(off), "stone", "lintel")
		gates.append([off, opening])


func _near_gate(offset: float, margin: float) -> bool:
	for g in gates:
		if absf(track.wrapped_delta(offset, g[0])) < margin:
			return true
	return false


# --- buildings -----------------------------------------------------------------------------

func _frame(p: Vector3, tangent: Vector3, right: Vector3, lateral: float, y: float) -> Transform3D:
	return Transform3D(Basis(tangent, Vector3.UP, right), p + right * lateral + Vector3(0, y, 0))


func _fits(xf: Transform3D, length: float, depth: float) -> bool:
	if not clear_rect(xf, length + 1.0, depth + 1.0):
		return false
	for f in buildings.footprints:
		var other: Transform3D = f[0]
		var size: Vector2 = f[1]
		if Vector2(other.origin.x - xf.origin.x, other.origin.z - xf.origin.z).length() < (size.x + length) * 0.5 + 1.5:
			return false
	return true


## Houses on the terraces between the lanes (centred on the halfway line
## where two lanes share a strip) and on the first terrace outside the
## outermost ring. Most are roofless ruins; about one in six is thatched.
func _village_houses() -> void:
	var half := track.road_width * 0.5
	for side in [-1.0, 1.0]:
		var next := -1.0
		for s in _main_samples:
			if s.section != Section.VILLAGE or (next >= 0.0 and s.offset < next) or _near_gate(s.offset, 16.0):
				continue
			var reach: float = s.reach[side]
			var lateral: float
			var depth: float
			if reach >= TERRACE_LIMIT - 0.1:
				lateral = half + 8.0
				depth = 8.0
			elif reach >= 6.2:
				var p: Vector3 = s.point + s.right * side * (half + reach + 2.0)
				if _neighbour_section(p) != Section.VILLAGE:
					continue
				lateral = half + reach
				depth = minf(8.5, 2.0 * (reach - VILLAGE_EDGE) - 3.0)
			else:
				continue
			var length := rng.randf_range(8.0, 14.0)
			var xf := _frame(s.point, s.tangent, s.right, side * lateral, STEP_H)
			if not _fits(xf, length, depth):
				continue
			var roof := rng.randf() < 0.17
			buildings.house(xf, length, depth, {"roof": roof, "ruin": rng.randf() < 0.3,
					"wall_h": rng.randf_range(3.2, 4.3), "door_side": -1 if side > 0.0 else 1})
			next = s.offset + length + rng.randf_range(4.0, 10.0)


## The plaza inside the S-bend: the great hall in one half, the stepped
## usnu platform in the other, a few loose stones.
func _plaza() -> void:
	var eye := Vector3(PLAZA_EYE.x, 0, PLAZA_EYE.y)
	var radial := eye.normalized()
	var along := Vector3.UP.cross(radial).normalized()
	var hall := Transform3D(Basis(along, Vector3.UP, radial), eye)
	for size in [Vector2(22, 9), Vector2(18, 8), Vector2(14, 7)]:
		if _fits(hall, size.x, size.y):
			buildings.great_hall(hall, size.x, size.y)
			plaza_buildings += 1
			break
	for base in [14.0, 11.0, 8.0]:
		if clear(-eye, base * 0.71):
			buildings.usnu(-eye, base)
			plaza_buildings += 1
			break
	for i in 6:
		var p := Vector3(rng.randf_range(-40, 40), 0, rng.randf_range(-40, 40))
		if clear(p, 3.0):
			buildings.rubble(p, 1.6)


## Qolqa storehouses in a row on the second terrace beside the shortcut,
## and a wooden sign at its mouth.
func _qolqa_row() -> void:
	if _qolqa_samples.is_empty():
		return
	var sc: TrackShortcut = track.shortcuts[0]
	var half := sc.road_width * 0.5
	var side := 1.0
	var room := {-1.0: 0.0, 1.0: 0.0}
	for s in _qolqa_samples:
		room[-1.0] += minf(s.reach[-1.0], 30.0)
		room[1.0] += minf(s.reach[1.0], 30.0)
	if room[-1.0] > room[1.0]:
		side = -1.0
	var d := LOBE_FIRST + STEP_DEPTH * 0.5
	var next := 40.0
	for s in _qolqa_samples:
		if s.offset < next or s.offset > sc.length - 40.0 or s.reach[side] < LOBE_FIRST + STEP_DEPTH - 0.5:
			continue
		var xf := _frame(s.point, s.tangent, s.right, side * (half + d), STEP_H)
		if not _fits(xf, 7.0, 4.6):
			continue
		buildings.qolqa(xf)
		qolqas += 1
		next = s.offset + 9.5
	# The sign: a board on two posts, facing cars coming into the shortcut.
	var s0: Dictionary = _qolqa_samples[int(_qolqa_samples.size() / 2.0)]
	for s in _qolqa_samples:
		if s.offset >= 48.0 and clear(s.point + s.right * side * (half + 3.0), 1.0):
			s0 = s
			break
	var post := _frame(s0.point, s0.tangent, s0.right, side * (half + 3.0), 0.0)
	for x in [-1.1, 1.1]:
		add_box("sign_wood", Vector3(0.18, 2.2, 0.18), post.translated_local(Vector3(0, 1.1, x)))
	var board := post.translated_local(Vector3(0, 2.0, 0))
	add_box("sign_wood", Vector3(0.12, 0.8, 2.8), board)
	var facing := Transform3D(Basis(Vector3.UP, atan2(s0.tangent.x, s0.tangent.z) + PI), board.origin - s0.tangent * 0.08)
	add_text("QOLQAS", facing, Color(1.0, 0.86, 0.35), 0.012, 96)


# --- valley --------------------------------------------------------------------------------

## Distance to the nearest road edge on the terrain grid: exact near the
## roads (edge_distance), spread outward with a chamfer pass beyond.
func _distance_field() -> void:
	var b := TERRAIN_BOUNDS
	_dnx = int(b.size.x / TERRAIN_CELL) + 1
	_dnz = int(b.size.y / TERRAIN_CELL) + 1
	_dist.resize(_dnx * _dnz)
	for iz in _dnz:
		for ix in _dnx:
			var e := edge_distance(Vector3(b.position.x + ix * TERRAIN_CELL, 0, b.position.y + iz * TERRAIN_CELL))
			_dist[iz * _dnx + ix] = e if e < ROAD_CELL * 1.4 else INF
	var c := TERRAIN_CELL
	var diag := TERRAIN_CELL * 1.4142
	for iz in _dnz:
		for ix in _dnx:
			var i := iz * _dnx + ix
			var v := _dist[i]
			if ix > 0:
				v = minf(v, _dist[i - 1] + c)
			if iz > 0:
				v = minf(v, _dist[i - _dnx] + c)
				if ix > 0:
					v = minf(v, _dist[i - _dnx - 1] + diag)
				if ix < _dnx - 1:
					v = minf(v, _dist[i - _dnx + 1] + diag)
			_dist[i] = v
	for iz in range(_dnz - 1, -1, -1):
		for ix in range(_dnx - 1, -1, -1):
			var i := iz * _dnx + ix
			var v := _dist[i]
			if ix < _dnx - 1:
				v = minf(v, _dist[i + 1] + c)
			if iz < _dnz - 1:
				v = minf(v, _dist[i + _dnx] + c)
				if ix < _dnx - 1:
					v = minf(v, _dist[i + _dnx + 1] + diag)
				if ix > 0:
					v = minf(v, _dist[i + _dnx - 1] + diag)
			_dist[i] = v


func road_distance(x: float, z: float) -> float:
	var fx := clampf((x - TERRAIN_BOUNDS.position.x) / TERRAIN_CELL, 0.0, _dnx - 1.001)
	var fz := clampf((z - TERRAIN_BOUNDS.position.y) / TERRAIN_CELL, 0.0, _dnz - 1.001)
	var ix := int(fx)
	var iz := int(fz)
	var tx := fx - ix
	var tz := fz - iz
	var a := lerpf(_dist[iz * _dnx + ix], _dist[iz * _dnx + ix + 1], tx)
	var b := lerpf(_dist[(iz + 1) * _dnx + ix], _dist[(iz + 1) * _dnx + ix + 1], tx)
	return lerpf(a, b, tz)


## Terrain lift: a ramp that stays a step below the terrace treads (so they
## hide it), meeting the top terrace, then the valley walls climbing to
## mountains with big rolling ridges.
func _carve(x: float, z: float) -> float:
	var d := road_distance(x, z)
	if d <= LOBE_FIRST:
		return 0.0
	var top := LOBE_FIRST + (STEPS - 1) * STEP_DEPTH
	if d <= top:
		return maxf(0.0, STEP_H * (d - LOBE_FIRST) / STEP_DEPTH - STEP_H - 0.8)
	var top_h := STEP_H * (top - LOBE_FIRST) / STEP_DEPTH - STEP_H - 0.8
	var last := STEP_H * STEPS - 0.3
	if d <= TERRACE_LIMIT:
		return lerpf(top_h, last, (d - top) / (TERRACE_LIMIT - top))
	var far := d - TERRACE_LIMIT
	var ridges := (_peak_noise.get_noise_2d(x, z) * 0.5 + 0.5) * 70.0 * smoothstep(0.0, 200.0, far)
	return last + far * 0.42 + far * far * 0.0004 + ridges


func ground_y(x: float, z: float) -> float:
	return SceneryTerrain.height_at(self, _noise, 0.6, x, z, _carve)


## Cloud forest on the slopes above the terraces, a few trees on the
## valley floor.
func _forest() -> void:
	var trees := TreeBuilder.new(self, "bark", "canopy", random_seed + 5)
	var b := TERRAIN_BOUNDS
	for i in 2600:
		var x := rng.randf_range(b.position.x, b.end.x)
		var z := rng.randf_range(b.position.y, b.end.y)
		var d := road_distance(x, z)
		if d < TERRACE_LIMIT + 4.0 or d > 380.0:
			if not (d > 7.0 and d < LOBE_FIRST - 3.0 and rng.randf() < 0.04):
				continue
		if not clear(Vector3(x, 0, z), 4.0):
			continue
		var s := rng.randf_range(0.7, 1.2)
		trees.place("rainforest", Transform3D(Basis(Vector3.UP, rng.randf() * TAU).scaled(Vector3.ONE * s),
				Vector3(x, ground_y(x, z) - 0.3, z)))
	trees.commit()


## Jagged Andean peaks around the valley, the tallest with snow.
func _far_peaks() -> void:
	var c := Vector3(VALLEY_CENTRE.x, 0, VALLEY_CENTRE.y)
	for i in 30:
		var a := TAU * i / 30.0 + rng.randf_range(-0.08, 0.08)
		var dist := rng.randf_range(1250.0, 2100.0)
		var h := rng.randf_range(380.0, 820.0)
		var r := h * rng.randf_range(0.75, 1.1)
		var pos := c + Vector3(cos(a) * dist, 120.0, sin(a) * dist)
		add_cone("peak_green", r, h * 0.55, Transform3D(Basis(Vector3.UP, rng.randf() * TAU), pos), 7)
		var rock_base := pos + Vector3(rng.randf_range(-20, 20), h * 0.35, rng.randf_range(-20, 20))
		add_cone("peak_rock", r * 0.55, h * 0.65, Transform3D(Basis(Vector3.UP, rng.randf() * TAU), rock_base), 6)
		if h > 700.0:
			add_cone("snow", r * 0.2, h * 0.24, Transform3D(Basis(Vector3.UP, rng.randf() * TAU),
					rock_base + Vector3(0, h * 0.65 * 0.63, 0)), 6)
