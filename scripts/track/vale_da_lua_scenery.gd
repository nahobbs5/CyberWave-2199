@tool
class_name ValeDaLuaScenery
extends TrackScenery
## Vale da Lua (GDD 8.6e): the Valley of the Moon in Chapada dos Veadeiros,
## Brazil. Smooth grey river-sculpted rock ("moon rock": rippled, dimpled,
## pocked with round potholes) cut by fast water. A river and its streams
## run through slot canyons beside the road and pass under it at four rock
## bridges, dropping over waterfalls into pools; two creeks run right along
## the road where it is an open rock shelf (no barrier: a bad line drops you
## in). The shortcut, Behind the Falls, is a ledge under a rock overhang with
## a curtain of water pouring past its outer edge into a pool. Green cerrado
## forest grows on the rock tops. Positions are layout coordinates matching
## vale_da_lua.tscn; the river data below is generated with it.

const ROCK_SHADER := preload("res://assets/shaders/moon_rock.gdshader")
const WATER_SHADER := preload("res://assets/shaders/flowing_water.gdshader")

## Generated by gen_vale.py (scratchpad): river polylines (x, water_y, z).
const RIVERS := {
	"main": [Vector3(60, -5, -330), Vector3(80, -5.3, -24), Vector3(118, -5.6, 80), Vector3(148, -5.8, 152), Vector3(160, -10.5, 172), Vector3(200, -10.8, 240), Vector3(234, -11, 318), Vector3(240, -13.6, 342), Vector3(230, -13.8, 430), Vector3(170, -14, 540), Vector3(110, -14.3, 641), Vector3(100, -14.6, 800), Vector3(90, -15, 960)],
	"east": [Vector3(900, -5, 215), Vector3(700, -5.3, 200), Vector3(496, -5.5, 170), Vector3(400, -6, 200), Vector3(300, -6.3, 222), Vector3(258, -6.4, 230), Vector3(222, -10.6, 238)],
	"west": [Vector3(-800, -6, 170), Vector3(-560, -6.3, 190), Vector3(-351, -6.5, 200), Vector3(-200, -7, 232), Vector3(-20, -7.3, 205), Vector3(130, -7.5, 206), Vector3(172, -10.6, 210)],
	"pool": [Vector3(470, -8, 425), Vector3(400, -8.4, 430), Vector3(320, -8.8, 432), Vector3(262, -9, 432), Vector3(236, -13.6, 432)],
	"creek1": [Vector3(276.5, -4.6, 2.5), Vector3(294.9, -4.64, 10.3), Vector3(313.3, -4.68, 18.1), Vector3(331.7, -4.73, 25.9), Vector3(350.2, -4.77, 33.7), Vector3(368.6, -4.81, 41.5), Vector3(387, -4.85, 49.3), Vector3(405.4, -4.89, 57.1), Vector3(424.1, -4.94, 64.8), Vector3(440.6, -4.98, 72.6), Vector3(432, -5.1, 130), Vector3(430, -5.85, 186)],
	"creek2": [Vector3(-329.7, -5, 497.1), Vector3(-330.4, -5.05, 480.8), Vector3(-327.5, -5.09, 462.7), Vector3(-323.7, -5.14, 442.9), Vector3(-319.9, -5.18, 423.3), Vector3(-316.1, -5.23, 403.6), Vector3(-312.3, -5.27, 384), Vector3(-308.5, -5.32, 364.3), Vector3(-304.8, -5.36, 344.7), Vector3(-293, -5.5, 250), Vector3(-296, -6.6, 212)],
}
## Channel half-width (rim to rim / 2) per river; the water is ~60% of it.
const WIDTHS := {"main": 11.0, "east": 9.0, "west": 9.0, "pool": 9.0, "creek1": 7.5, "creek2": 7.5, "spring": 9.0}
## Rivers drawn as water only (no channel, no carve, no recovery boxes).
const WATER_ONLY := ["spring"]
## The stream over the shortcut's overhang, falling as a curtain past the ledge.
const SPRING := [Vector3(556, 10.7, 425), Vector3(494, 10.6, 425), Vector3(491, -8.0, 425)]
const OVERHANG_CENTRE := Vector3(506, 0, 425)
const OVERHANG_HALF := Vector2(16.0, 18.0)
const OVERHANG_Y := 9.0
const DOME := Vector3(600, 0, 440)
const DOME_RADIUS := 75.0
const DOME_HEIGHT := 11.0
const TERRAIN_BOUNDS := Rect2(-700, -330, 1640, 1300)
const TERRAIN_AMPLITUDE := 4.5
const BOULDER_VARIANTS := 10
const BOULDER_CHUNK := 120.0
## Drops taller than this count as waterfalls.
const FALL_MIN := 2.0

var river_crossings: int = 0
## Water height under the road at each crossing (tests: well below it).
var crossing_depths: PackedFloat32Array = PackedFloat32Array()
var waterfalls: int = 0
var river_drop: float = 0.0
## Free-standing boulders (centre, radius) for tests: none on a road.
var boulder_origins: PackedVector3Array = PackedVector3Array()
var boulder_radii: PackedFloat32Array = PackedFloat32Array()
var bridge_boulders: int = 0

var _noise: FastNoiseLite
var _bins: Dictionary = {}
var _boulders: Dictionary = {}
var _boulder_meshes: Array[ArrayMesh] = []
var _rivers: Dictionary = {}

const BIN := 40.0


func build() -> void:
	river_crossings = 0
	crossing_depths.clear()
	waterfalls = 0
	river_drop = 0.0
	boulder_origins.clear()
	boulder_radii.clear()
	bridge_boulders = 0
	_boulders.clear()
	cast_shadows = true
	no_shadow_keys = ["water", "foam", "mist", "rock_terrain"]
	_setup_materials()
	_rivers.clear()
	for name in RIVERS:
		_rivers[name] = PackedVector3Array(RIVERS[name])
	_rivers["spring"] = PackedVector3Array(SPRING)
	_index_rivers()
	_noise = SceneryTerrain.make_noise(random_seed)
	await step(0.05)
	SceneryTerrain.build(self, TERRAIN_BOUNDS, 8.0, TERRAIN_AMPLITUDE, -100.0, "rock_terrain", "rock_terrain", "", random_seed, _carve)
	await step(0.3)
	for name in _rivers:
		if not WATER_ONLY.has(name):
			_channel(name)
		_water(name)
	await step(0.5)
	_count_crossings()
	_rock_bridges()
	_shelf_rocks()
	_overhang()
	await step(0.6)
	_rim_boulders()
	_driftwood()
	await step(0.7)
	_forest()
	_far_hills()
	await step(0.85)
	_river_zone()
	_commit_boulders()


# --- river data ------------------------------------------------------------------------

## Bins every river segment by area so the carve stays quick.
func _index_rivers() -> void:
	_bins.clear()
	for name in _rivers:
		if WATER_ONLY.has(name):
			continue
		var pts: PackedVector3Array = _rivers[name]
		var w: float = WIDTHS[name]
		for i in pts.size() - 1:
			var a := pts[i]
			var b := pts[i + 1]
			var lo := Vector2(minf(a.x, b.x) - w, minf(a.z, b.z) - w)
			var hi := Vector2(maxf(a.x, b.x) + w, maxf(a.z, b.z) + w)
			for bx in range(int(floor(lo.x / BIN)), int(floor(hi.x / BIN)) + 1):
				for bz in range(int(floor(lo.y / BIN)), int(floor(hi.y / BIN)) + 1):
					var key := Vector2i(bx, bz)
					if not _bins.has(key):
						_bins[key] = []
					(_bins[key] as Array).append([a, b, w])


## Nearest river at (x, z): [distance, water height, half-width] or [] if none.
func river_at(x: float, z: float) -> Array:
	var list: Array = _bins.get(Vector2i(int(floor(x / BIN)), int(floor(z / BIN))), [])
	var best: Array = []
	var best_ratio := 1.0
	for seg in list:
		var a: Vector3 = seg[0]
		var b: Vector3 = seg[1]
		var w: float = seg[2]
		var ab := Vector2(b.x - a.x, b.z - a.z)
		var ap := Vector2(x - a.x, z - a.z)
		var t := clampf(ap.dot(ab) / maxf(ab.length_squared(), 0.001), 0.0, 1.0)
		var d := (ap - ab * t).length()
		if d < w * best_ratio:
			best_ratio = d / w
			best = [d, _water_y(a.y, b.y, t), w]
	return best


## Water height along a segment: drops of FALL_MIN or more happen right at
## the end (a waterfall), smaller ones slope (rapids).
static func _water_y(y0: float, y1: float, t: float) -> float:
	if y0 - y1 >= FALL_MIN:
		return y0 if t < 0.88 else lerpf(y0, y1, (t - 0.88) / 0.12)
	return lerpf(y0, y1, t)


## Terrain carve: river slots, and the rock dome above the shortcut.
func _carve(x: float, z: float) -> float:
	var c := 0.0
	var r := river_at(x, z)
	if not r.is_empty():
		var d: float = r[0]
		var w: float = r[2]
		var water: float = r[1]
		var t := 1.0 - smoothstep(w * 0.72, w * 1.0, d)
		c = -(absf(water) + 9.0) * t
	var dd := Vector2(x - DOME.x, z - DOME.z).length()
	if dd < DOME_RADIUS:
		var u := dd / DOME_RADIUS
		c += DOME_HEIGHT * (1.0 - u * u) * (1.0 - u * u)
	return c


func ground_y(x: float, z: float) -> float:
	return SceneryTerrain.height_at(self, _noise, TERRAIN_AMPLITUDE, x, z, _carve)


# --- materials ------------------------------------------------------------------------

func _setup_materials() -> void:
	var rock := ShaderMaterial.new()
	rock.shader = ROCK_SHADER
	register_material("rock", rock)
	var terrain := ShaderMaterial.new()
	terrain.shader = ROCK_SHADER
	terrain.set_shader_parameter("pale", Color(0.55, 0.54, 0.52))
	register_material("rock_terrain", terrain)
	var water := ShaderMaterial.new()
	water.shader = WATER_SHADER
	register_material("water", water)
	var foam := StandardMaterial3D.new()
	foam.albedo_color = Color(0.95, 0.98, 1.0, 0.85)
	foam.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	foam.emission_enabled = true
	foam.emission = Color(0.9, 0.95, 1.0)
	foam.emission_energy_multiplier = 0.25
	foam.roughness = 0.6
	register_material("foam", foam)
	var mist := StandardMaterial3D.new()
	mist.albedo_color = Color(0.92, 0.96, 1.0, 0.18)
	mist.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	mist.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	mist.cull_mode = BaseMaterial3D.CULL_DISABLED
	register_material("mist", mist)
	material("driftwood", Color(0.62, 0.58, 0.52), 0.0, 0.0, 0.85)
	material("bark", Color(0.3, 0.25, 0.2), 0.0, 0.0, 0.9)
	material("canopy", Color(0.24, 0.42, 0.18), 0.0, 0.0, 0.85)
	material("hills", Color(0.32, 0.42, 0.28), 0.0, 0.0, 1.0)


# --- channels and water ------------------------------------------------------------------

## Samples a river every ~3 m: [position (water height in y), tangent].
func _samples(pts: PackedVector3Array) -> Array:
	var out: Array = []
	for i in pts.size() - 1:
		var a := pts[i]
		var b := pts[i + 1]
		var flat := Vector2(b.x - a.x, b.z - a.z)
		var n := maxi(1, int(ceil(flat.length() / 3.0)))
		if a.y - b.y >= FALL_MIN:
			n = maxi(n, 8)
		var dir := Vector3(flat.x, 0, flat.y).normalized()
		for k in n:
			var t := float(k) / n
			out.append([Vector3(lerpf(a.x, b.x, t), _water_y(a.y, b.y, t), lerpf(a.z, b.z, t)), dir])
	var last := pts[pts.size() - 1]
	var pre := pts[pts.size() - 2]
	out.append([last, Vector3(last.x - pre.x, 0, last.z - pre.z).normalized()])
	return out


## The slot canyon a river runs in: smooth, wavy rock walls from the ground
## at the rims down to a bed under the water, with smooth normals.
func _channel(name: String) -> void:
	var w: float = WIDTHS[name]
	var samples := _samples(_rivers[name])
	var cols := 13
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	var wobble := FastNoiseLite.new()
	wobble.seed = random_seed + name.hash() % 1000
	wobble.frequency = 0.06
	for s in samples.size():
		var p: Vector3 = samples[s][0]
		var dir: Vector3 = samples[s][1]
		var side := Vector3(-dir.z, 0, dir.x)
		for c in cols:
			var u := float(c) / (cols - 1) * 2.0 - 1.0  # -1 left rim .. +1 right rim
			var a := absf(u)
			var bulge := wobble.get_noise_2d(s * 3.0, u * 20.0) * 1.6
			var lat := u * w + signf(u) * bulge * a
			var y: float
			if a > 0.97:
				y = ground_y(p.x + side.x * lat, p.z + side.z * lat) + 0.05
			else:
				# Wall: from the rim down to the water, then a bed below it.
				var rim := ground_y(p.x + side.x * w * signf(u), p.z + side.z * w * signf(u))
				var wall := clampf((0.97 - a) / 0.32, 0.0, 1.0)
				y = lerpf(rim, p.y + 0.3, smoothstep(0.0, 1.0, wall))
				if a < 0.65:
					y = p.y - 0.4 - 1.6 * (1.0 - a / 0.65)
				y += wobble.get_noise_2d(s * 5.0 + 50.0, u * 30.0) * 0.6 * (1.0 - a)
			st.set_uv(Vector2(u, s * 0.75))
			st.add_vertex(Vector3(p.x + side.x * lat, y, p.z + side.z * lat))
	for s in samples.size() - 1:
		for c in cols - 1:
			var i0 := s * cols + c
			var i1 := i0 + 1
			var i2 := i0 + cols
			var i3 := i2 + 1
			st.add_index(i0)
			st.add_index(i2)
			st.add_index(i1)
			st.add_index(i1)
			st.add_index(i2)
			st.add_index(i3)
	st.generate_normals()
	var mi := add_mesh_instance(st.commit(), get_material("rock"), "Channel_" + name)
	mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_ON


## The moving water: a ribbon at the water height with UVs along the flow,
## foam at rapids and below falls. Waterfalls get churn and mist at the foot.
func _water(name: String) -> void:
	var w: float = WIDTHS[name] * (0.62 if not WATER_ONLY.has(name) else 1.0)
	var samples := _samples(_rivers[name])
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	var along := 0.0
	var foam_left := 0.0
	var prev := Vector3.ZERO
	var pts: PackedVector3Array = _rivers[name]
	for i in pts.size() - 1:
		var drop := pts[i].y - pts[i + 1].y
		if drop >= FALL_MIN:
			waterfalls += 1
			_fall_foot(pts[i + 1], w, drop)
	river_drop = maxf(river_drop, pts[0].y - pts[pts.size() - 1].y)
	for s in samples.size():
		var p: Vector3 = samples[s][0]
		var dir: Vector3 = samples[s][1]
		var side := Vector3(-dir.z, 0, dir.x)
		if s > 0:
			along += p.distance_to(prev)
			var dy := prev.y - p.y
			if dy > 0.6:
				foam_left = 12.0
		foam_left = maxf(0.0, foam_left - (p.distance_to(prev) if s > 0 else 0.0))
		prev = p
		var foam := clampf(foam_left / 12.0, 0.0, 1.0)
		# Falling water: this sample or the next one is part of a drop.
		var falling := 0.0
		if s + 1 < samples.size() and p.y - (samples[s + 1][0] as Vector3).y > 0.6:
			falling = 1.0
		if s > 0 and (samples[s - 1][0] as Vector3).y - p.y > 0.6:
			falling = 1.0
		for k in 2:
			var u := float(k)
			st.set_color(Color(foam, falling, 0))
			st.set_uv(Vector2(u, along / 4.0))
			st.add_vertex(p + side * (u * 2.0 - 1.0) * w)
	for s in samples.size() - 1:
		var i0 := s * 2
		st.add_index(i0)
		st.add_index(i0 + 2)
		st.add_index(i0 + 1)
		st.add_index(i0 + 1)
		st.add_index(i0 + 2)
		st.add_index(i0 + 3)
	st.generate_normals()
	add_mesh_instance(st.commit(), get_material("water"), "Water_" + name)


## White churn and mist where a waterfall lands.
func _fall_foot(p: Vector3, w: float, drop: float) -> void:
	for k in 7:
		var o := Vector3(rng.randf_range(-w, w) * 0.7, 0.1, rng.randf_range(-w, w) * 0.7)
		add_sphere("foam", rng.randf_range(1.0, 2.2), Transform3D(Basis.from_scale(Vector3(1.4, 0.35, 1.4)), p + o), 4, 8)
	for k in 4:
		var o := Vector3(rng.randf_range(-w, w) * 0.6, rng.randf_range(1.0, minf(drop, 6.0)), rng.randf_range(-w, w) * 0.6)
		add_sphere("mist", rng.randf_range(2.5, 4.5), Transform3D(Basis(), p + o), 5, 9)


## Where the rivers pass under the roads (for tests and the bridge rocks).
func _count_crossings() -> void:
	for name in _rivers:
		if WATER_ONLY.has(name):
			continue
		var inside := false
		for smp in _samples(_rivers[name]):
			var p: Vector3 = smp[0]
			var on_road := edge_distance(Vector3(p.x, 0, p.z)) < 0.0
			if on_road and not inside:
				river_crossings += 1
				crossing_depths.append(p.y)
			inside = on_road


# --- rock -------------------------------------------------------------------------------

## Rock slabs under the road where it bridges a river, so the bridge reads as
## a natural rock arch from below and from the banks.
func _rock_bridges() -> void:
	for name in _rivers:
		if WATER_ONLY.has(name):
			continue
		var w: float = WIDTHS[name]
		for smp in _samples(_rivers[name]):
			var p: Vector3 = smp[0]
			if edge_distance(Vector3(p.x, 0, p.z)) > 0.0:
				continue
			var off := track.curve.get_closest_offset(Vector3(p.x, 0, p.z))
			var d := -w - 6.0
			while d <= w + 6.0:
				var f := at(track.wrap_offset(off + d))
				for side: float in [-1.0, 0.0, 1.0]:
					var c := f * Vector3(side * (track.road_width * 0.5 + 1.0), -2.4, 0)
					_place_boulder(c, Vector3(rng.randf_range(4.5, 6.0), 2.0, rng.randf_range(4.5, 6.0)), true)
				d += 4.0
			break


## Rock under the open edges of the shelves, down into the creek.
func _shelf_rocks() -> void:
	for e in track.open_edges:
		var o := e.x - 10.0
		while o < e.y + 10.0:
			var f := at(track.wrap_offset(o))
			var c := f * Vector3(e.z * (track.road_width * 0.5 - 0.5), -1.8, 0)
			_place_boulder(c, Vector3(2.6, 1.7, 3.2), true)
			o += 3.5


## The rock overhang over the shortcut ledge, where the stream pours off.
func _overhang() -> void:
	var c := OVERHANG_CENTRE
	var x := -OVERHANG_HALF.x
	while x <= OVERHANG_HALF.x:
		var z := -OVERHANG_HALF.y
		while z <= OVERHANG_HALF.y:
			_place_boulder(Vector3(c.x + x, OVERHANG_Y + 0.8 + rng.randf_range(-0.3, 0.3), c.z + z),
					Vector3(5.5, 1.6, 5.5), true)
			z += 6.0
		x += 6.0
	# Pillars of rock on the dome side holding it up.
	for z in [-14.0, 0.0, 14.0]:
		var base := Vector3(c.x + OVERHANG_HALF.x - 2.0, 0.0, c.z + z)
		_place_boulder(base + Vector3(0, 4.5, 0), Vector3(3.5, 5.5, 3.5), true)


## Whether a point is under the overhang (Overdrive flight height).
func is_roofed(p: Vector3) -> bool:
	return absf(p.x - OVERHANG_CENTRE.x) <= OVERHANG_HALF.x and absf(p.z - OVERHANG_CENTRE.z) <= OVERHANG_HALF.y


## Smooth boulders along the canyon rims and scattered over the rock.
func _rim_boulders() -> void:
	for name in _rivers:
		if WATER_ONLY.has(name):
			continue
		var w: float = WIDTHS[name]
		var samples := _samples(_rivers[name])
		for s in range(0, samples.size(), 3):
			var p: Vector3 = samples[s][0]
			var dir: Vector3 = samples[s][1]
			var side := Vector3(-dir.z, 0, dir.x)
			for sgn: float in [-1.0, 1.0]:
				if rng.randf() < 0.35:
					continue
				var r := rng.randf_range(1.5, 4.5)
				var lat := sgn * (w * rng.randf_range(0.85, 1.25))
				var pos := p + side * lat
				pos.y = ground_y(pos.x, pos.z) + r * 0.1
				# Some sit down in the water.
				if rng.randf() < 0.25:
					pos = p + side * sgn * w * rng.randf_range(0.2, 0.55)
					pos.y = p.y + r * 0.15
				if clear(Vector3(pos.x, 0, pos.z), r):
					_place_boulder(pos, Vector3(r, r * rng.randf_range(0.5, 0.8), r * rng.randf_range(0.8, 1.2)), false)
	# Scattered over the rock tops.
	var b := TERRAIN_BOUNDS
	for i in 260:
		var x := rng.randf_range(b.position.x, b.end.x)
		var z := rng.randf_range(b.position.y, b.end.y)
		var r := rng.randf_range(1.5, 6.0)
		if not clear(Vector3(x, 0, z), r + 1.0) or not river_at(x, z).is_empty():
			continue
		_place_boulder(Vector3(x, ground_y(x, z) + r * 0.05, z), Vector3(r, r * rng.randf_range(0.45, 0.75), r * rng.randf_range(0.8, 1.3)), false)


func _place_boulder(pos: Vector3, size: Vector3, structural: bool) -> void:
	var v := rng.randi_range(0, BOULDER_VARIANTS - 1)
	var key := "%d@%d,%d" % [v, int(floor(pos.x / BOULDER_CHUNK)), int(floor(pos.z / BOULDER_CHUNK))]
	if not _boulders.has(key):
		_boulders[key] = []
	var xf := Transform3D(Basis(Vector3.UP, rng.randf() * TAU).scaled(size), pos)
	(_boulders[key] as Array).append(xf)
	if structural:
		bridge_boulders += 1
	else:
		boulder_origins.append(pos)
		boulder_radii.append(maxf(size.x, size.z))


func boulder_count() -> int:
	return boulder_origins.size() + bridge_boulders


func _commit_boulders() -> void:
	if _boulder_meshes.is_empty():
		for v in BOULDER_VARIANTS:
			_boulder_meshes.append(_boulder_mesh(random_seed * 31 + v))
	for key in _boulders:
		var v := int((key as String).get_slice("@", 0))
		var cs := (key as String).get_slice("@", 1)
		var centre := Vector3((int(cs.get_slice(",", 0)) + 0.5) * BOULDER_CHUNK, 0, (int(cs.get_slice(",", 1)) + 0.5) * BOULDER_CHUNK)
		var list: Array = _boulders[key]
		var mm := MultiMesh.new()
		mm.transform_format = MultiMesh.TRANSFORM_3D
		mm.mesh = _boulder_meshes[v]
		mm.instance_count = list.size()
		for i in list.size():
			mm.set_instance_transform(i, (list[i] as Transform3D).translated(-centre))
		var mmi := MultiMeshInstance3D.new()
		mmi.name = "Boulders_%s" % (key as String).replace("@", "_").replace(",", "_")
		mmi.multimesh = mm
		mmi.position = centre
		mmi.material_override = get_material("rock")
		mmi.visibility_range_end = 420.0
		add_node(mmi)
	_boulders.clear()


## A smooth, water-worn boulder of radius ~1: a sphere pushed in and out by
## noise, flattened underneath, with smooth normals.
func _boulder_mesh(seed_value: int) -> ArrayMesh:
	var noise := FastNoiseLite.new()
	noise.seed = seed_value
	noise.frequency = 0.9
	var rings := 10
	var segs := 16
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	for r in rings + 1:
		var phi := PI * r / rings
		for s in segs + 1:
			var th := TAU * s / segs
			var dir := Vector3(sin(phi) * cos(th), cos(phi), sin(phi) * sin(th))
			var k := 1.0 + noise.get_noise_3dv(dir * 1.3) * 0.28 + noise.get_noise_3dv(dir * 3.1 + Vector3(9, 9, 9)) * 0.08
			var p := dir * k
			if p.y < -0.25:
				p.y = -0.25 + (p.y + 0.25) * 0.25
			st.set_uv(Vector2(float(s) / segs, float(r) / rings))
			st.add_vertex(p)
	for r in rings:
		for s in segs:
			var i0 := r * (segs + 1) + s
			var i1 := i0 + 1
			var i2 := i0 + segs + 1
			var i3 := i2 + 1
			st.add_index(i0)
			st.add_index(i1)
			st.add_index(i2)
			st.add_index(i1)
			st.add_index(i3)
			st.add_index(i2)
	st.generate_normals()
	return st.commit()


# --- wood and green ------------------------------------------------------------------------

## Bleached driftwood logs jammed in the channels.
func _driftwood() -> void:
	for name in ["main", "east", "west", "pool"]:
		var w: float = WIDTHS[name]
		var samples := _samples(_rivers[name])
		for s in range(10, samples.size(), 23):
			var p: Vector3 = samples[s][0]
			var dir: Vector3 = samples[s][1]
			var length := rng.randf_range(5.0, 9.0)
			var yaw := atan2(dir.x, dir.z) + rng.randf_range(0.6, 1.2) * (1.0 if rng.randf() < 0.5 else -1.0)
			var basis := Basis(Vector3.UP, yaw) * Basis(Vector3.RIGHT, PI * 0.5 + rng.randf_range(-0.25, 0.25))
			var c := p + Vector3(0, 0.6, 0) - basis.y * length * 0.5
			if clear(Vector3(p.x, 0, p.z), length * 0.5):
				add_cyl("driftwood", rng.randf_range(0.18, 0.32), length, Transform3D(basis, c), 7, 0.14)


## Cerrado forest on the rock tops, away from roads and canyons.
func _forest() -> void:
	var trees := TreeBuilder.new(self, "bark", "canopy", random_seed + 5)
	var b := TERRAIN_BOUNDS
	for i in 1400:
		var x := rng.randf_range(b.position.x, b.end.x)
		var z := rng.randf_range(b.position.y, b.end.y)
		if edge_distance(Vector3(x, 0, z)) < 12.0 or not river_at(x, z).is_empty():
			continue
		var y := ground_y(x, z)
		if y < -0.5:
			continue
		var kind := "rainforest" if rng.randf() < 0.7 else "palm"
		var s := rng.randf_range(0.7, 1.15)
		trees.place(kind, Transform3D(Basis(Vector3.UP, rng.randf() * TAU).scaled(Vector3.ONE * s), Vector3(x, y, z)))
	trees.commit()


## Low green hills on the horizon.
func _far_hills() -> void:
	var c := TERRAIN_BOUNDS.get_center()
	for i in 22:
		var a := TAU * i / 22 + rng.randf_range(-0.1, 0.1)
		var d := rng.randf_range(1100.0, 1400.0)
		var pos := Vector3(c.x + cos(a) * d, -2.0, c.y + sin(a) * d)
		add_cone("hills", rng.randf_range(180.0, 320.0), rng.randf_range(60.0, 130.0), Transform3D(Basis(), pos), 9)


# --- hazard ---------------------------------------------------------------------------------

## One RecoveryZone along every river at the water line: a car that falls
## in (off an open shelf) splashes and is put back on the road.
func _river_zone() -> void:
	var zone := RecoveryZone.new()
	zone.name = "RiverWater"
	zone.reason = "water"
	for name in _rivers:
		if WATER_ONLY.has(name):
			continue
		var w: float = WIDTHS[name] * 0.7
		var samples := _samples(_rivers[name])
		for s in range(0, samples.size(), 2):
			var p: Vector3 = samples[s][0]
			var dir: Vector3 = samples[s][1]
			if p.y + 2.5 > -1.5:
				continue
			var box := zone.add_box(p + Vector3(0, 0.5, 0), Vector3(w * 2.0, 4.0, 7.0))
			box.basis = Basis(Vector3.UP, atan2(dir.x, dir.z))
	add_node(zone)
